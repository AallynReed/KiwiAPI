 "scope_catalog_json": "[{\"key\":\"rotations:read\",\"bit\":1,\"resource\":\"rotations\",\"description\":\"Read rotation/timer data - server time, bonuses, merchants, biomes\"},{\"key\":\"feeds:read\",\"bit\":2,\"resource\":\"feeds\",\"description\":\"Read relayed feeds - Trove news, Twitch/YouTube/Bilibili\"},{\"key\":\"stats:read\",\"bit\":4,\"resource\":\"stats\",\"description\":\"Read raw game-stat data - stat tables (power rank / magic find / light) and classes\"},{\"key\":\"gems:read\",\"bit\":8,\"resource\":\"gems\",\"description\":\"Use the gem tools - simulator (generate/augment), evaluator, and build optimizer\"},{\"key\":\"misc:read\",\"bit\":16,\"resource\":\"misc\",\"description\":\"Misc tools - third-party modding software list and the time converter\"},{\"key\":\"mods:read\",\"bit\":32,\"resource\":\"mods\",\"description\":\"Mod tools - decompile a .tmod file and build a .tmod from files\"},{\"key\":\"updates:read\",\"bit\":64,\"resource\":\"updates\",\"description\":\"Browse archived game files - versions, directory structure, and single-file download\"},{\"key\":\"codexes:read\",\"bit\":128,\"resource\":\"codexes\",\"description\":\"Read parsed game codexes - collectibles, styles, recipes and items, the relationships between them, badge requirements and progression trees\"},{\"key\":\"btt:read\",\"bit\":256,\"resource\":\"btt\",\"description\":\"Read BetterTroveTools releases - latest version per platform and channel\"},{\"key\":\"leaderboards:read\",\"bit\":512,\"resource\":\"leaderboards\",\"description\":\"Read Trove in-game leaderboards - boards, entries, timestamps\"},{\"key\":\"market:read\",\"bit\":1024,\"resource\":\"market\",\"description\":\"Read Trove marketplace listings - listings, items, interest list, price history\"},{\"key\":\"activity:read\",\"bit\":2048,\"resource\":\"activity\",\"description\":\"Read Trove player-activity estimates - live active-player count and multi-period trend series\"},{\"key\":\"giveaways:read\",\"bit\":4096,\"resource\":\"giveaways\",\"description\":\"Read public giveaways - ongoing draws, prizes, entry counts\"},{\"key\":\"events:read\",\"bit\":8192,\"resource\":\"events\",\"description\":\"Subscribe to the live event stream (SSE) - real-time challenge + chaos-chest push updates\"},{\"key\":\"ocr:read\",\"bit\":16384,\"resource\":\"ocr\",\"description\":\"Read character stats from a screenshot - self-hosted OCR of the in-game stat sheet\"},{\"key\":\"store:read\",\"bit\":32768,\"resource\":\"store\",\"description\":\"Read the in-game Kiwi Store catalog - categories, products, prices, deals, loot odds\"},{\"key\":\"mods:write\",\"bit\":65536,\"resource\":\"mods\",\"description\":\"Manage Mods Hub projects for creators who connected their account to yours - create mods, cut and publish releases, edit metadata, images and visibility\"}]",

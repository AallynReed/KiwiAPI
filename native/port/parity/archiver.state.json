{
 "mongo": [
  {"collection": "update_branches", "sort": ["branch"], "mask": ["_id", "last_probe_at"]},
  {"collection": "update_versions", "sort": ["branch", "ordinal"], "mask": ["captured_at", "completed_at"],
   "filter": {"branch": "live-us"}},
  {"collection": "update_versions", "sort": ["branch", "ordinal"], "filter": {"branch": "pts"}},
  {"collection": "update_changes", "sort": ["branch", "ordinal", "path"], "mask": ["_id"]},
  {"collection": "update_state", "sort": ["branch", "path"], "mask": ["_id"]},
  {"collection": "update_manifest", "sort": ["branch", "path"], "mask": ["_id"]}
 ],
 "redis": [
  {"pattern": "events:sig:game_update"}
 ]
}

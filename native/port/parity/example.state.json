{
 "mongo": [
  {"collection": "supporters", "sort": ["name"], "mask": ["_id", "created_at"]},
  {"collection": "design_feedback", "sort": ["_id"], "mask": ["updated_at"]},
  {"collection": "runtime_config", "sort": ["key"], "filter": {"key": "design_feedback_rate_limit_max"}}
 ],
 "postgres": [
  {"table": "board", "order_by": "uuid"}
 ],
 "redis": [
  {"pattern": "rl:designfeedback:*", "mask_ttl": true, "mask_value": true}
 ]
}

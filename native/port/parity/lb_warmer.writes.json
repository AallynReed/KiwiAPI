[
 {
  "name": "boot_pass_published",
  "sleep": 60,
  "path": "/site/leaderboards/timestamps?limit=4",
  "capture": {
   "KEEP": "items[1]",
   "GAP": "items[2]"
  }
 },
 {
  "name": "boot_cheaters",
  "path": "/site/leaderboards/cheaters",
  "mask": [
   "computed_at"
  ]
 },
 {
  "name": "boot_activity",
  "path": "/site/leaderboards/activity",
  "mask": [
   "computed_at"
  ]
 },
 {
  "name": "boot_class_activity",
  "path": "/site/leaderboards/class-activity/current",
  "mask": [
   "computed_at"
  ]
 },
 {
  "name": "boot_renames",
  "path": "/site/leaderboards/renames"
 },
 {
  "name": "boot_duplicates",
  "path": "/site/leaderboards/duplicates"
 },
 {
  "name": "boot_days",
  "path": "/site/leaderboards/days"
 },
 {
  "name": "warm_noauth",
  "method": "POST",
  "path": "/v1/leaderboards/warm",
  "compare_headers": [
   "www-authenticate"
  ]
 },
 {
  "name": "warm_bad_token",
  "method": "POST",
  "path": "/v1/leaderboards/warm",
  "headers": {
   "Authorization": "Bearer kiwi_not_a_real_token"
  }
 },
 {
  "name": "warm_get_405",
  "path": "/v1/leaderboards/warm",
  "compare_headers": [
   "allow"
  ]
 },
 {
  "name": "warm_jwt",
  "method": "POST",
  "path": "/v1/leaderboards/warm",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "warm_token",
  "method": "POST",
  "path": "/v1/leaderboards/warm",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_TOKEN}"
  },
  "compare_headers": [
   "x-ratelimit-limit"
  ]
 },
 {
  "name": "warm_token_cooldown",
  "method": "POST",
  "path": "/v1/leaderboards/warm",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_TOKEN}"
  },
  "compare_headers": [
   "retry-after"
  ]
 },
 {
  "name": "after_warm_cheaters",
  "sleep": 30,
  "path": "/site/leaderboards/cheaters",
  "mask": [
   "computed_at"
  ]
 },
 {
  "name": "after_warm_timestamps",
  "path": "/site/leaderboards/timestamps?limit=4"
 },
 {
  "name": "delete_noauth",
  "method": "POST",
  "path": "/v1/leaderboards/delete-anchor?anchor=1"
 },
 {
  "name": "delete_missing_anchor",
  "method": "POST",
  "path": "/v1/leaderboards/delete-anchor",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "delete_bad_query",
  "method": "POST",
  "path": "/v1/leaderboards/delete-anchor?anchor=abc&recompute=maybe",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "delete_unknown_anchor",
  "method": "POST",
  "path": "/v1/leaderboards/delete-anchor?anchor=1",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "delete_keep_history",
  "method": "POST",
  "path": "/v1/leaderboards/delete-anchor?anchor=${KEEP}&recompute=false",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "delete_recompute",
  "method": "POST",
  "path": "/v1/leaderboards/delete-anchor?anchor=${GAP}",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "delete_again_nothing_left",
  "method": "POST",
  "path": "/v1/leaderboards/delete-anchor?anchor=${GAP}&recompute=1",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "delete_put_405",
  "method": "PUT",
  "path": "/v1/leaderboards/delete-anchor",
  "compare_headers": [
   "allow"
  ]
 },
 {
  "name": "after_delete_timestamps",
  "sleep": 45,
  "path": "/site/leaderboards/timestamps?limit=4"
 },
 {
  "name": "after_delete_activity",
  "path": "/site/leaderboards/activity",
  "mask": [
   "computed_at"
  ],
  "sleep": 90
 },
 {
  "name": "after_delete_cheaters",
  "path": "/site/leaderboards/cheaters",
  "mask": [
   "computed_at"
  ]
 },
 {
  "name": "reingest_noauth",
  "method": "POST",
  "path": "/v1/leaderboards/reingest-backlog"
 },
 {
  "name": "reingest_bad_flag",
  "method": "POST",
  "path": "/v1/leaderboards/reingest-backlog?clear_first=perhaps",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "reingest_empty_backlog",
  "method": "POST",
  "path": "/v1/leaderboards/reingest-backlog?clear_first=true",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "reingest_status",
  "path": "/v1/leaderboards/reingest-status",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "recompute_cheaters",
  "method": "POST",
  "path": "/v1/leaderboards/cheaters/recompute",
  "headers": {
   "Authorization": "Bearer ${KIWI_PARITY_JWT}"
  }
 },
 {
  "name": "after_recompute_cheaters",
  "sleep": 30,
  "path": "/site/leaderboards/cheaters",
  "mask": [
   "computed_at"
  ]
 },
 {
  "name": "settled",
  "sleep": 15,
  "path": "/site/leaderboards/timestamps?limit=4"
 }
]

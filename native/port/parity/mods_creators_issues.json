 {"name": "creator_link_get", "path": "/v1/mods/hub/creator-links/abc"},
 {"name": "creator_links_preflight", "method": "OPTIONS", "path": "/v1/mods/hub/creator-links",
  "headers": {"Origin": "https://dev.aallyn.net", "Access-Control-Request-Method": "POST",
              "Access-Control-Request-Headers": "authorization,content-type"}},

 {"name": "creator_token_noauth", "path": "/site/mods/creator-token"},
 {"name": "creator_token_portal_jwt", "path": "/site/mods/creator-token",
  "headers": {"Authorization": "Bearer ${KIWI_PARITY_JWT}"}},
 {"name": "creator_token_rotate_get", "path": "/site/mods/creator-token/rotate"},
 {"name": "creator_connection_get", "path": "/site/mods/creator-connections/abc"}
]

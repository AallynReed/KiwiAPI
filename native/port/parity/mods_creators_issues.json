[
 {"name": "pick_a_mod", "path": "/site/mods/projects?limit=1&sort=downloads",
  "capture": {"H": "items[0].handle", "S": "items[0].slug"}},

 {"name": "issues_open", "path": "/v1/mods/hub/projects/${H}/${S}/issues"},
 {"name": "issues_all", "path": "/v1/mods/hub/projects/${H}/${S}/issues?status=all&limit=100"},
 {"name": "issues_closed_page", "path": "/v1/mods/hub/projects/${H}/${S}/issues?status=closed&limit=2&offset=1"},
 {"name": "issues_with_token", "path": "/v1/mods/hub/projects/${H}/${S}/issues?status=all",
  "headers": {"Authorization": "Bearer ${KIWI_PARITY_TOKEN}"}},
 {"name": "issues_head", "method": "HEAD", "path": "/v1/mods/hub/projects/${H}/${S}/issues"},
 {"name": "issues_422", "path": "/v1/mods/hub/projects/${H}/${S}/issues?status=bogus&limit=0&offset=-1"},
 {"name": "issues_422_limit", "path": "/v1/mods/hub/projects/${H}/${S}/issues?limit=101"},
 {"name": "issues_case_handle", "path": "/v1/mods/hub/projects/%20${H}%20/${S}/issues"},
 {"name": "issues_unknown_mod", "path": "/v1/mods/hub/projects/${H}/no-such-mod-parity/issues"},
 {"name": "issues_unknown_handle", "path": "/v1/mods/hub/projects/nobody-parity-xyz/x/issues"},
 {"name": "issues_stray_unknown", "path": "/v1/mods/hub/projects/stray/no-such-stray-parity/issues"},
 {"name": "issue_1", "path": "/v1/mods/hub/projects/${H}/${S}/issues/1"},
 {"name": "issue_1_float", "path": "/v1/mods/hub/projects/${H}/${S}/issues/1.0"},
 {"name": "issue_missing", "path": "/v1/mods/hub/projects/${H}/${S}/issues/987654"},
 {"name": "issue_bad_number", "path": "/v1/mods/hub/projects/${H}/${S}/issues/abc"},
 {"name": "issue_huge_number", "path": "/v1/mods/hub/projects/${H}/${S}/issues/99999999999999999999"},
 {"name": "issue_comments_get", "path": "/v1/mods/hub/projects/${H}/${S}/issues/1/comments"},
 {"name": "issue_comment_get", "path": "/v1/mods/hub/projects/${H}/${S}/issues/1/comments/abc"},

 {"name": "site_issues", "path": "/site/mods/projects/${H}/${S}/issues"},
 {"name": "site_issues_all", "path": "/site/mods/projects/${H}/${S}/issues?status=all"},
 {"name": "site_issues_422", "path": "/site/mods/projects/${H}/${S}/issues?offset=x"},
 {"name": "site_issue_1", "path": "/site/mods/projects/${H}/${S}/issues/1"},
 {"name": "site_issue_missing", "path": "/site/mods/projects/${H}/${S}/issues/987654"},
 {"name": "site_issues_unknown", "path": "/site/mods/projects/nobody-parity-xyz/x/issues"},
 {"name": "site_notifications_anon", "path": "/site/mods/notifications"},
 {"name": "site_notifications_bad_cookie", "path": "/site/mods/notifications",
  "headers": {"Cookie": "kiwi_site_access=not-a-jwt", "Sec-Fetch-Site": "same-origin"}},
 {"name": "site_notifications_portal_jwt", "path": "/site/mods/notifications",
  "headers": {"Authorization": "Bearer ${KIWI_PARITY_JWT}"}},

 {"name": "me_notifications_noauth", "path": "/v1/mods/hub/me/issue-notifications"},
 {"name": "me_notifications_portal_jwt", "path": "/v1/mods/hub/me/issue-notifications",
  "headers": {"Authorization": "Bearer ${KIWI_PARITY_JWT}"}},
 {"name": "me_notifications_api_token", "path": "/v1/mods/hub/me/issue-notifications",
  "headers": {"Authorization": "Bearer ${KIWI_PARITY_TOKEN}"}},
 {"name": "me_notifications_bad_token", "path": "/v1/mods/hub/me/issue-notifications",
  "headers": {"Authorization": "Bearer kiwi_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_zzzzzz"}},
 {"name": "me_seen_get", "path": "/v1/mods/hub/me/issue-notifications/seen"},

 {"name": "creator_links_admin", "path": "/v1/mods/hub/creator-links",
  "headers": {"Authorization": "Bearer ${KIWI_PARITY_JWT}"}, "mask": ["items[0].last_used_at", "items[1].last_used_at", "items[2].last_used_at", "items[3].last_used_at", "items[4].last_used_at", "items[0].request_count", "items[1].request_count", "items[2].request_count", "items[3].request_count", "items[4].request_count"]},
 {"name": "creator_links_noauth", "path": "/v1/mods/hub/creator-links"},
 {"name": "creator_links_api_token", "path": "/v1/mods/hub/creator-links",

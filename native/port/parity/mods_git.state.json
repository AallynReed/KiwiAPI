{
 "mongo": [
  {"collection": "mod_git_tokens", "sort": ["name", "revoked"], "mask": ["_id", "token_hash", "prefix", "created_at", "last_used_at"]},
  {"collection": "mod_projects", "sort": ["slug"], "mask": ["updated_at"]},
  {"collection": "mod_creator_links", "sort": ["label"], "mask": ["last_used_at"]},
  {"collection": "runtime_config", "sort": ["key"], "filter": {"key": "feature_mods_hub_enabled"}, "mask": ["updated_at"]}
 ],
 "redis": [
  {"pattern": "rl:public:mods:*", "mask_ttl": true, "mask_value": true}
 ]
}

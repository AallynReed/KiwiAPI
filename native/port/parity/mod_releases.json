[
 {"name": "pick_top", "path": "/v1/mods/hub/projects?sort=downloads&limit=3",
  "capture": {"H0": "items[0].handle", "S0": "items[0].slug", "H1": "items[1].handle", "S1": "items[1].slug",
              "H2": "items[2].handle", "S2": "items[2].slug", "BANNER": "items[0].banner_sha", "PREVIEW": "items[0].preview_sha"}},
 {"name": "releases_0", "path": "/v1/mods/hub/projects/${H0}/${S0}/releases", "capture": {"R0": "items[0].id"}},
 {"name": "releases_1", "path": "/v1/mods/hub/projects/${H1}/${S1}/releases", "capture": {"R1": "items[0].id"}},
 {"name": "releases_2", "path": "/v1/mods/hub/projects/${H2}/${S2}/releases", "capture": {"R2": "items[0].id"}},

 {"name": "v1_release", "path": "/v1/mods/hub/releases/${R0}", "compare_headers": ["x-ratelimit-limit"]},
 {"name": "v1_release_token", "path": "/v1/mods/hub/releases/${R1}", "headers": {"Authorization": "Bearer ${KIWI_PARITY_TOKEN}"},
  "compare_headers": ["x-ratelimit-limit", "x-ratelimit-remaining"]},
 {"name": "v1_release_bad_id", "path": "/v1/mods/hub/releases/nope"},
 {"name": "v1_release_unknown", "path": "/v1/mods/hub/releases/000000000000000000000000"},
 {"name": "v1_release_head", "method": "HEAD", "path": "/v1/mods/hub/releases/${R0}"},
 {"name": "v1_release_options", "method": "OPTIONS", "path": "/v1/mods/hub/releases/${R0}",
  "headers": {"Origin": "https://docs.aallyn.net", "Access-Control-Request-Method": "GET"}},
 {"name": "v1_files", "path": "/v1/mods/hub/releases/${R0}/files"},
 {"name": "v1_files_1", "path": "/v1/mods/hub/releases/${R1}/files"},
 {"name": "v1_inspect", "path": "/v1/mods/hub/releases/${R0}/inspect"},
 {"name": "v1_inspect_2", "path": "/v1/mods/hub/releases/${R2}/inspect"},
 {"name": "v1_cfgs", "path": "/v1/mods/hub/releases/${R0}/cfgs"},
 {"name": "v1_swfs", "path": "/v1/mods/hub/releases/${R0}/swfs"},
 {"name": "v1_blueprints", "path": "/v1/mods/hub/releases/${R0}/blueprints"},
 {"name": "v1_blueprints_1", "path": "/v1/mods/hub/releases/${R1}/blueprints"},
 {"name": "v1_file_missing", "path": "/v1/mods/hub/releases/${R0}/file?path=nope/missing.dds"},
 {"name": "v1_file_no_path", "path": "/v1/mods/hub/releases/${R0}/file"},
 {"name": "v1_file_long_path", "path": "/v1/mods/hub/releases/${R0}/file?path=${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}${S0}"},
 {"name": "v1_cfg_not_cfg", "path": "/v1/mods/hub/releases/${R0}/cfg?path=ui/thing.swf"},
 {"name": "v1_blueprint_missing", "path": "/v1/mods/hub/releases/${R0}/blueprint?path=blueprints/none.blueprint"},
 {"name": "v1_blueprint_bad_fmt", "path": "/v1/mods/hub/releases/${R0}/blueprint?path=a.blueprint&fmt=xml"},
 {"name": "v1_swf_scripts_missing", "path": "/v1/mods/hub/releases/${R0}/swf/scripts?path=ui/none.swf"},
 {"name": "v1_release_post", "method": "POST", "path": "/v1/mods/hub/releases/${R0}/files"},

 {"name": "site_files", "path": "/site/mods/releases/${R0}/files"},
 {"name": "site_inspect", "path": "/site/mods/releases/${R1}/inspect"},
 {"name": "site_cfgs", "path": "/site/mods/releases/${R1}/cfgs"},
 {"name": "site_swfs", "path": "/site/mods/releases/${R0}/swfs"},
 {"name": "site_blueprints", "path": "/site/mods/releases/${R2}/blueprints"},
 {"name": "site_vfx", "path": "/site/mods/releases/${R0}/vfx"},
 {"name": "site_vfx_manifest_missing", "path": "/site/mods/releases/${R0}/vfx/manifest?path=none.pkfx"},
 {"name": "site_vfx_asset_unreferenced", "path": "/site/mods/releases/${R0}/vfx/asset?path=textures/none.dds"},
 {"name": "site_audio", "path": "/site/mods/releases/${R0}/audio"},
 {"name": "site_audio_bank_missing", "path": "/site/mods/releases/${R0}/audio/bank?path=none.bnk"},
 {"name": "site_audio_sound_bad_id", "path": "/site/mods/releases/${R0}/audio/sound?path=a.bnk&id=-1"},
 {"name": "site_file_missing", "path": "/site/mods/releases/${R0}/file?path=nope"},
 {"name": "site_cfg_missing", "path": "/site/mods/releases/${R0}/cfg?path=nope.cfg"},
 {"name": "site_blueprint_missing", "path": "/site/mods/releases/${R0}/blueprint?path=x.blueprint"},
 {"name": "site_unknown", "path": "/site/mods/releases/000000000000000000000000/files"},
 {"name": "site_bad_id", "path": "/site/mods/releases/zz/inspect"},
 {"name": "site_cookie_junk", "path": "/site/mods/releases/${R0}/files", "headers": {"Cookie": "kiwi_site_access=junk"}},

 {"name": "image_banner", "path": "/v1/mods/hub/image/${BANNER}", "compare_headers": ["content-length"]},
 {"name": "image_preview_site", "path": "/site/mods/image/${PREVIEW}", "compare_headers": ["content-length"]},
 {"name": "image_bad_width", "path": "/v1/mods/hub/image/${BANNER}?w=300"},
 {"name": "image_bad_width_site", "path": "/site/mods/image/${BANNER}?w=300"},
 {"name": "image_width_not_int", "path": "/v1/mods/hub/image/${BANNER}?w=big"},
 {"name": "image_unknown", "path": "/v1/mods/hub/image/0000"},
 {"name": "image_unknown_site", "path": "/site/mods/image/0000"},
 {"name": "image_thumb_708", "path": "/site/mods/image/${PREVIEW}?w=708", "compare_headers": ["content-length"]},
 {"name": "image_thumb_400", "path": "/v1/mods/hub/image/${BANNER}?w=400", "compare_headers": ["content-length"]}
]

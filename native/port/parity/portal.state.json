{
 "mongo": [
  {"collection": "users", "sort": ["email"], "mask": ["_id", "hashed_password", "created_at", "updated_at", "last_login_at"]},
  {"collection": "sessions", "sort": ["user_id", "device", "revoked"], "mask": ["_id", "user_id", "refresh_token_hash", "created_at", "last_used_at", "expires_at"]},
  {"collection": "api_tokens", "sort": ["name"], "filter": {"name": {"$ne": "parity run"}},
   "mask": ["_id", "prefix", "hashed_token", "ip_salt", "allowed_ip_hashes", "created_at", "expires_at", "rotated_at", "revoked_at"]},
  {"collection": "usage_events", "sort": ["route"], "mask": ["_id"]},
  {"collection": "email_outbox", "sort": ["to", "subject"], "mask": ["_id"]}
 ],
 "redis": [
  {"pattern": "rl:signup:*", "mask_ttl": true, "mask_value": true},
  {"pattern": "rl:login:*", "mask_ttl": true, "mask_value": true},
  {"pattern": "rl:tokencreate:*", "mask_ttl": true, "mask_value": true},
  {"pattern": "rl:forgot:*", "mask_ttl": true, "mask_value": true},
  {"pattern": "rl:resend:*", "mask_ttl": true, "mask_value": true},
  {"pattern": "loginfail:*", "mask_ttl": true},
  {"pattern": "loginlock:*", "mask_ttl": true},
  {"pattern": "oauth*", "mask_ttl": true}
 ]
}

{
 "mongo": [
  {"collection": "mod_projects", "sort": ["owner_handle", "slug"], "mask": ["updated_at", "remix_requested_at", "remix_resolved_at"],
   "filter": {"slug": {"$regex": "^mm-"}}},
  {"collection": "mod_releases", "sort": ["tag"], "mask": ["announced_at"],
   "filter": {"_id": {"$in": [{"$oid": "65ae00000000000000000080"}, {"$oid": "65ae00000000000000000081"}, {"$oid": "65ae00000000000000000082"}, {"$oid": "65ae00000000000000000083"}, {"$oid": "65ae00000000000000000084"}]}}},
  {"collection": "mod_profiles", "sort": ["handle"], "mask": ["updated_at"], "filter": {"handle": "mmowner"}},
  {"collection": "content_reports", "sort": ["reason"], "filter": {"target_label": {"$in": ["Kiwi Sword", "mmowner", "Pack"]}}},
  {"collection": "mod_claim_requests", "sort": ["created_at"], "mask": ["resolved_at"],
   "filter": {"project_slug": {"$regex": "^mm-"}}},
  {"collection": "mod_remix_claims", "sort": ["created_at"], "mask": ["resolved_at"],
   "filter": {"claimant_username": "mmowner"}},
  {"collection": "mod_taken_down_artifacts", "sort": ["sha256"], "mask": ["_id", "created_at"], "filter": {}},
  {"collection": "mod_stars", "sort": ["project_id"], "filter": {"site_user_id": {"$oid": "65ae00000000000000000002"}}},
  {"collection": "mod_issues", "sort": ["number"], "filter": {"author_id": {"$oid": "65ae00000000000000000002"}}},
  {"collection": "mod_issue_events", "sort": ["issue_id"], "filter": {"author_id": {"$oid": "65ae00000000000000000002"}}},
  {"collection": "modpack_projects", "sort": ["slug"], "mask": ["updated_at"], "filter": {"slug": {"$regex": "^mm-"}}},
  {"collection": "modpack_stars", "sort": ["modpack_id"], "filter": {"site_user_id": {"$oid": "65ae00000000000000000001"}}},
  {"collection": "stray_import_state", "sort": ["key"], "filter": {}},
  {"collection": "email_outbox", "sort": ["to", "subject"], "mask": ["_id", "created_at", "next_attempt_at"],
   "filter": {"to": {"$regex": "^mm"}}}
 ]
}

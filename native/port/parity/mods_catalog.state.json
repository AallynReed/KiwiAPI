{
 "mongo": [
  {"collection": "mod_projects", "sort": ["owner_handle", "slug"],
   "mask": ["_id", "created_at", "updated_at", "remix_resolved_at"]},
  {"collection": "mod_releases", "sort": ["project_id", "branch", "tag"], "mask": ["announced_at", "updated_at"]},
  {"collection": "mod_stars", "sort": ["project_id", "site_user_id"], "mask": ["_id", "created_at"]},
  {"collection": "mod_profiles", "sort": ["handle"], "mask": ["_id", "created_at", "updated_at"]},
  {"collection": "mod_images", "sort": ["sha"], "mask": ["_id", "created_at"]},
  {"collection": "mod_claim_requests", "sort": ["project_slug"], "mask": ["_id", "created_at"]},
  {"collection": "mod_remix_claims", "sort": ["target_slug"], "mask": ["_id", "created_at"]},
  {"collection": "mod_taken_down_artifacts", "sort": ["sha256"], "mask": ["_id", "created_at"]},
  {"collection": "mod_download_events", "sort": ["project_id", "created_at"]},
  {"collection": "site_users", "sort": ["username"]}
 ],
 "redis": [
  {"pattern": "events:sig:mod_release"},
  {"pattern": "rl:*", "mask_ttl": true, "mask_value": true}
 ]
}

__pycache__/
*.py[cod]
.venv/
venv/
.venv-check/
.env

# Local AI-assistant / editor tooling
.claude/
.idea/
.vscode/

# Local Mongo data folder (bind mount target)
data/

# Game-file version archive - content-addressed blob store (bind mount target, many GB)
.game_updates/

# Server-side ingest backlog - gzipped dumps keyed by anchor (bind mount target, can grow large)
.backlog/

# BetterTroveTools showcase site - binary assets are ~20 MB of screenshots,
# shipped to the server via Syncthing rather than git. Templates + CSS + JS are tracked.
site/static/assets/

.mypy_cache/
.pytest_cache/
.ruff_cache/

# Tests are kept LOCAL only (run with `pytest tests/unit`), not pushed to the
# remote. Deployment is via Syncthing and the Docker image only COPYs `app/`,
# so the shipped artifact never included them anyway.
tests/

# Local mobile-preview dir - symlinked copy of site/templates + static junction,
# served by `python -m http.server` for fast viewport iteration.
_preview/

# Internal living spec + audit - local reference, not shipped artefacts
PROJECT_SPEC.md
SECURITY_AUDIT.md
# Internal handoff docs (engine/design write-ups) - local reference, not shipped.
# docs/ otherwise holds the public API-reference site, so ignore only handoffs.
*-handoff.md

# Database backups (never commit data dumps)
backups/

# Syncthing per-machine state / in-flight temp files
.stfolder/
~syncthing~*
*.tmp

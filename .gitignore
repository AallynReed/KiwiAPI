__pycache__/
*.py[cod]
.venv/
venv/
.venv-check/
.env

# Local AI-assistant / editor tooling
.claude/
.idea/
.vscode/

# Local Mongo data folder (bind mount target)
data/

# Game-file version archive - content-addressed blob store (bind mount target, many GB)
.game_updates/

# Server-side ingest backlog - gzipped dumps keyed by anchor (bind mount target, can grow large)
.backlog/

# Mods Hub store - shared mods' git repos, images + compiled .tmod (bind mount target, user content)
.mods/

# File drops - whatever people upload through a one-off PIN link (bind mount target, user content)
.drops/

# BetterTroveTools showcase site - binary assets are ~20 MB of screenshots,
# copied to the server by hand rather than git. Templates + CSS + JS are tracked.
# assets/data/ is the exception: hand-maintained stat tables the /calculators
# page fetches at runtime, so they have to ship with the repo or a deploy can
# never update them.
site/static/assets/*
!site/static/assets/data/

# Minified build output - regenerated from source by scripts/minify_static.py on
# every deploy. Top-level glob only, matching what the script actually generates;
# vendored minified libs (fonts/, vendor/) stay tracked.
/site/static/*.min.css
/site/static/*.min.js

.mypy_cache/
.pytest_cache/
.ruff_cache/

# Tests are kept LOCAL only (run with `pytest tests/unit`), not pushed to the
# remote. The source tree is copied to the server by hand and the Docker image
# only COPYs `app/`, so the shipped artifact never included them anyway.
tests/

# Local mobile-preview dir - symlinked copy of site/templates + static junction,
# served by `python -m http.server` for fast viewport iteration.
_preview/

# Local design-skill config (impeccable) - reference only, not shipped
.impeccable/

# Internal living spec + audit - local reference, not shipped artefacts
*.md
# Internal handoff docs (engine/design write-ups) - local reference, not shipped.
# docs/ otherwise holds the public API-reference site, so ignore only handoffs.
*-handoff.md

# Database backups (never commit data dumps)
backups/

*.tmp

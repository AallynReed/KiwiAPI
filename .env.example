# Copy to .env and fill in. docker compose reads this file automatically and
# injects the values into the api container.

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_insecure_dev_secret_do_not_use_in_production

# --- MongoDB auth (REQUIRED) ---
# Use URL-safe passwords (no @ : / # in them). Auth only initializes on a FRESH
# ./data/mongo dir - wipe it once to enable auth on an existing deployment.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=kiwi_app
MONGO_APP_PASSWORD=
MONGO_DB=kiwi

# --- Redis (REQUIRED) ---
REDIS_PASSWORD=

# --- Postgres (REQUIRED - the leaderboards datastore: entries/boards/players/activity) ---
# Everything else stays in Mongo. Only the password is required; DB/user/DSN have
# sane defaults (see docker-compose.yml). Set a strong password.
POSTGRES_PASSWORD=
# POSTGRES_DB=kiwi_lb
# POSTGRES_USER=kiwi

# Captcha for signup protection. Provider is "turnstile" (Cloudflare, free) or
# "hcaptcha" - both use the same verify flow, so only the keys differ.
# If CAPTCHA_SECRET is empty, the signup captcha check is SKIPPED (dev only).
#   Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
#   hCaptcha:             https://dashboard.hcaptcha.com/
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=
CAPTCHA_SITEKEY=

# Master/admin account. On startup the app creates this account (or promotes an
# existing one) to superuser, granting access to /admin/* (revoke any token,
# inspect activity). Leave blank to skip. Use a strong password.
ADMIN_EMAIL=support@aallyn.net
ADMIN_PASSWORD=

# Per-request usage events are retained this many days, then auto-expired.
USAGE_RETENTION_DAYS=30

# Email - outgoing mail via the host's Postfix server (verification + reset).
# For a local Postfix relay, host.docker.internal:25 with no auth/TLS is typical;
# Postfix must trust the docker subnet (mynetworks) to relay without SMTP AUTH.
# Leave SMTP_HOST blank to disable email (links are logged instead).
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=no-reply@aallyn.net

# Daily rate-limit digest: who gets it, and the minimum 429s in 24h to bother.
RATE_LIMIT_ALERT_EMAIL=aallyn@aallyn.net
RATE_LIMIT_ALERT_THRESHOLD=20

# "Sign in with GitHub" (optional). Create a GitHub OAuth App with callback URL
#   https://api.aallyn.net/auth/oauth/github/callback
# then paste the credentials here. Leave blank to disable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# "Sign in with Discord" + Discord interactions (optional). On discord.dev:
#   OAuth2 redirect:        https://api.aallyn.net/auth/oauth/discord/callback  (scopes: identify email)
#   Interactions Endpoint:  https://api.aallyn.net/discord/interactions
# CLIENT_ID is the Application ID; PUBLIC_KEY verifies interaction webhooks.
# Leave blank to disable. Keep the SECRET out of git.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Login scope (default "identify email"). Add "applications.commands" AND set
# INTEGRATION_TYPE=1 to also user-install the app's commands during login.
DISCORD_OAUTH_SCOPE=identify email
DISCORD_OAUTH_INTEGRATION_TYPE=
# Bot token (optional): only needed to REGISTER slash commands, or to run a
# gateway bot (real-time events). NOT needed for login or the interactions webhook.
DISCORD_BOT_TOKEN=
# Enable the gateway bot's Server Members privileged intent (default true). Powers
# the Discord avatar auto-sync: a user changing their picture is mirrored into their
# website account without a re-login. Needs the "Server Members Intent" toggle in the
# Discord Developer Portal (already required by the club roster); if it isn't granted
# the bot starts without it and avatars just refresh at login. Set false to opt out.
BOT_MEMBERS_INTENT=true
# "Add to Discord" install link for the home-page button (separate from login).
# Blank = auto-built from CLIENT_ID; or paste the exact Install Link from
# discord.dev's Installation page (enable BOTH User + Guild install contexts there).
DISCORD_INSTALL_URL=

# Delve-rotation source (week-based external API). Leave blank to keep the
# background refresher OFF (imported delve history is still served either way).
# REFERER is optional - only set it if the source requires one.
TROVE_DELVE_SOURCE_URL=
TROVE_DELVE_SOURCE_REFERER=

# BetterTroveTools releases relay (drives the desktop app's update checks).
# Repo defaults to AallynReed/BetterTroveTools. The PAT is optional and only
# needed if the unauthenticated 60/hr GitHub rate limit becomes a problem.
BTT_RELEASES_REPO=
BTT_RELEASES_TOKEN=

# --- Community feeds: Twitch + YouTube credentials ---
# Powers /v1/feeds/{twitch,youtube} (Bilibili is a credential-less scrape).
# These are the SAME names the trovesaurus bot used - copy the values straight
# across from its .env. Leave blank to disable that feed (it just serves empty).
#   Twitch:  https://dev.twitch.tv/console/apps  (client-credentials app)
#   YouTube: a Google Cloud "YouTube Data API v3" key
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YT_API_KEY=

# Only needed when running the app OUTSIDE Docker (compose sets these itself):
# MONGO_URI=mongodb://localhost:27016
# MONGO_DB=kiwi
# DEBUG=false

# --- Production Tuning ---
# Number of uvicorn workers to spawn in production (docker-compose.prod.yml). Defaults to 8.
# API_WORKERS=8

